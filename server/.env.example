PORT=5001
NODE_ENV=development

# Cloudflare D1 Database (5 GB Free Serverless SQL - Recommended)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_uuid
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_with_d1_permissions

# Alternative MongoDB URI (Atlas or Local)
MONGODB_URI=mongodb://localhost:27017/notex_db

# Security & JWT
JWT_SECRET=notex_super_secret_jwt_key_2026_academic_project
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5173

# Google OAuth & Drive
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

